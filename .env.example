# Copy to .env (never commit .env). Names map to everand_books.config.Settings fields.
# Both values are cookies of a signed-in everand.com browser session.
EVERAND_BOOKS_SESSION_TOKEN=
EVERAND_BOOKS_USER_ID=
# Optional, shown with their defaults.
# EVERAND_BOOKS_BASE_URL=https://www.everand.com
# EVERAND_BOOKS_ACCESS_TOKEN_TTL_SECONDS=540
# EVERAND_BOOKS_HTTP_TIMEOUT_SECONDS=30
# EVERAND_BOOKS_HTTP_MAX_ATTEMPTS=3
# EVERAND_BOOKS_HTTP_MAX_RETRY_DELAY_SECONDS=10
# EVERAND_BOOKS_HTTP_MAX_CONCURRENCY=8
# DEBUG, INFO, WARNING, ERROR or CRITICAL
# EVERAND_BOOKS_LOG_LEVEL=INFO
# text, or json for one object per line
# EVERAND_BOOKS_LOG_FORMAT=text
