# Copy to .env (never commit .env). Names map to pyeverand.config.Settings fields.
# Both values are cookies of a signed-in everand.com browser session.
PYEVERAND_SESSION_TOKEN=
PYEVERAND_USER_ID=
# Optional, shown with their defaults.
# PYEVERAND_BASE_URL=https://www.everand.com
# PYEVERAND_ACCESS_TOKEN_TTL_SECONDS=540
# PYEVERAND_HTTP_TIMEOUT_SECONDS=30
# PYEVERAND_HTTP_MAX_ATTEMPTS=3
# PYEVERAND_HTTP_MAX_RETRY_DELAY_SECONDS=10
# PYEVERAND_HTTP_MAX_CONCURRENCY=8
# DEBUG, INFO, WARNING, ERROR or CRITICAL
# PYEVERAND_LOG_LEVEL=INFO
# text, or json for one object per line
# PYEVERAND_LOG_FORMAT=text
# Port of the graphical interface (pyeverand-gui).
# PYEVERAND_GUI_PORT=8080
# Restart the interface when its source changes (development). Works only when started with
# python -m pyeverand.interfaces.nicegui_app
# PYEVERAND_GUI_RELOAD=false
